<!-- Styles of the Zenith app, built on the design tokens (design/tokens/Cores.xaml). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Cores.xaml" />
    <ResourceDictionary Source="Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Manrope ships inside the app; Segoe UI only if it fails to load. -->
  <FontFamily x:Key="Fonte">pack://application:,,,/Fonts/#Manrope, Segoe UI</FontFamily>

  <!-- Tints the tokens do not name: the Resgate green at 12% (selected nav, icon tiles) and the overlay backdrop. -->
  <SolidColorBrush x:Key="ResgateSuaveBrush" Color="#1F4E7D6C" />
  <SolidColorBrush x:Key="FundoOverlayBrush" Color="#66172036" />

  <!-- Text -->
  <Style x:Key="Eyebrow" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}" />
  </Style>
  <Style x:Key="Title" TargetType="TextBlock">
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LineHeight" Value="44" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource TextoPrincipalBrush}" />
  </Style>
  <Style x:Key="Lead" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="25.6" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextoForteBrush}" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource TextoPrincipalBrush}" />
  </Style>
  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}" />
  </Style>
  <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19.5" />
  </Style>
  <Style x:Key="BigNumber" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{StaticResource TextoPrincipalBrush}" />
  </Style>

  <!-- Surfaces -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SuperficieCartaoBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SuperficieBordaBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RaioCartao}" />
    <Setter Property="Padding" Value="22,18" />
  </Style>
  <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="CornerRadius" Value="{StaticResource RaioPainel}" />
    <Setter Property="Padding" Value="22,20" />
  </Style>
  <!-- Capsule: fixed height with a radius of exactly half, a hairline edge, and the text centered on the
       cap height (Manrope sits a little low in its line box, hence the 1 px lift). -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SuperficieFundoBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SuperficieBordaBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="ChipText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextoForteBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,0,1" />
  </Style>
  <Style x:Key="IconTile" TargetType="Border">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="{StaticResource RaioControle}" />
    <Setter Property="Background" Value="{StaticResource SuperficieFundoBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="IconPath" TargetType="Path">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="Stroke" Value="{StaticResource TextoForteBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Buttons: 44 px minimum touch size, calm hover, no glow. -->
  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextoPrincipalBrush}" />
    <Setter Property="Background" Value="{StaticResource SuperficieCartaoBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SuperficieBordaControleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RaioControle}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource SuperficieFundoBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ModulosResgateBrush}" />
              <Setter TargetName="Box" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource SuperficieCartaoBrush}" />
    <Setter Property="Background" Value="{StaticResource ModulosResgateBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RaioControle}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource ModulosResgateTextoBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource ModulosResgateTextoBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- A quiet text button ("De onde veio isso"). -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextoForteBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="Transparent" Padding="0,4">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextoPrincipalBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Sidebar navigation -->
  <Style x:Key="NavButton" TargetType="RadioButton">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextoForteBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Box" Background="Transparent" CornerRadius="{StaticResource RaioControle}" Padding="14,0">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource SuperficieFundoBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource ResgateSuaveBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextoPrincipalBrush}" />
              <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dialogs: HDR test and guides -->
  <Style x:Key="Dialog" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SuperficieCartaoBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RaioDestaque}" />
    <Setter Property="Padding" Value="32,28" />
    <Setter Property="Width" Value="560" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.18" Color="#172036" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DialogTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource TextoPrincipalBrush}" />
  </Style>

  <Style x:Key="Scroll" TargetType="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>
  <!-- Tray menu: a small card, like the dialogs. -->
  <Style x:Key="TrayMenu" TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource Fonte}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Margin="10" Padding="6" MinWidth="220" Background="{StaticResource SuperficieCartaoBrush}"
                  BorderBrush="{StaticResource SuperficieBordaBrush}" BorderThickness="1" CornerRadius="{StaticResource RaioCartao}">
            <Border.Effect>
              <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.16" Color="#172036" />
            </Border.Effect>
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TrayMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource TextoPrincipalBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bg" Padding="12,9" CornerRadius="{StaticResource RaioControle}" Background="Transparent">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False" />
              <Path x:Name="Check" Grid.Column="1" Margin="16,0,0,0" Width="12" Height="9" Stretch="Uniform" Visibility="Collapsed"
                    Data="M1,5 L4.5,8.5 L11,1" Stroke="{StaticResource ModulosResgateBrush}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource SuperficieFundoBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TrayMenuSeparator" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="8,4" Background="{StaticResource SuperficieDivisoriaBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
