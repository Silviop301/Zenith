<!-- App opening, as in design/marca/ascensao-final.html: the dots appear one by one, rising to the top,
     a halo opens around the top dot, then the name slides in. Plays once. -->
<Window x:Class="Zenith.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:Zenith.Core.Resources;assembly=Zenith.Core"
        Title="Zenith"
        Icon="pack://application:,,,/zenith.ico"
        Width="480" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="False"
        WindowStartupLocation="CenterScreen">
  <Border x:Name="Root" CornerRadius="22" Background="{StaticResource MarcaNoiteBrush}" UseLayoutRounding="True">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <!-- 64-unit box of the symbol, drawn at 104 px like the design. -->
      <Viewbox Width="104" Height="104">
        <Canvas Width="64" Height="64">
          <Ellipse x:Name="Dot1" Canvas.Left="16" Canvas.Top="39.6" Width="4.8" Height="4.8" Fill="{StaticResource MarcaLuzBrush}" RenderTransformOrigin="0.5,0.5" />
          <Ellipse x:Name="Dot2" Canvas.Left="20.8" Canvas.Top="29.3" Width="6.4" Height="6.4" Fill="{StaticResource MarcaLuzBrush}" RenderTransformOrigin="0.5,0.5" />
          <Ellipse x:Name="Dot3" Canvas.Left="27.8" Canvas.Top="22.6" Width="8" Height="8" Fill="{StaticResource MarcaLuzBrush}" RenderTransformOrigin="0.5,0.5" />
          <Ellipse x:Name="Halo" Canvas.Left="36.6" Canvas.Top="19.1" Width="10.8" Height="10.8" Stroke="{StaticResource MarcaLuzBrush}" StrokeThickness="0.6"
                   RenderTransformOrigin="0.5,0.5" Opacity="0" />
          <Ellipse x:Name="Dot4" Canvas.Left="36.6" Canvas.Top="19.1" Width="10.8" Height="10.8" Fill="{StaticResource MarcaLuzBrush}" RenderTransformOrigin="0.5,0.5" />
        </Canvas>
      </Viewbox>
      <TextBlock x:Name="Word" Text="{x:Static r:Strings.AppName}" FontFamily="{StaticResource Fonte}" FontSize="52" FontWeight="ExtraBold"
                 Foreground="{StaticResource MarcaLuzBrush}" VerticalAlignment="Center" Margin="18,0,0,6">
        <TextBlock.RenderTransform>
          <TranslateTransform x:Name="WordShift" />
        </TextBlock.RenderTransform>
      </TextBlock>
    </StackPanel>
  </Border>
</Window>
