<UserControl x:Class="Zenith.App.Views.BestiaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Zenith.App.Controls"
             xmlns:r="clr-namespace:Zenith.Core.Resources;assembly=Zenith.Core">
  <UserControl.Resources>
    <!-- The Bestiário's own accent (#55628F) on the primary button. -->
    <Style x:Key="BestiaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{StaticResource ModulosBestiarioBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RaioControle}"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource ModulosBestiarioTextoBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource ModulosBestiarioTextoBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Filter capsule: dark when selected, like the mockup. -->
    <Style x:Key="FilterChip" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Height="40" CornerRadius="20" Padding="16,0" BorderThickness="1" SnapsToDevicePixels="True"
                    Background="{StaticResource SuperficieCartaoBrush}" BorderBrush="{StaticResource SuperficieBordaControleBrush}">
              <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,1"
                         Foreground="{StaticResource TextoForteBrush}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource SuperficieFundoBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource MarcaNoiteBrush}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource MarcaNoiteBrush}" />
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource MarcaLuzBrush}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One inhabitant in the grid. -->
    <Style x:Key="InhabitantCard" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Style="{StaticResource Card}" Padding="18,16" SnapsToDevicePixels="True"
                    BorderBrush="{Binding Level, Converter={StaticResource LevelBrush}, ConverterParameter=border}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SuperficieBordaControleBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsWorrying}" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource StatusPerigoBordaBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ModulosBestiarioBrush}" />
                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                <Setter TargetName="Box" Property="Padding" Value="17,15" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FicheLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
      <Setter Property="Margin" Value="0,20,0,8" />
    </Style>
  </UserControl.Resources>

  <!-- The page's own DataContext stays the shell's, so the shell's Visibility binding on this page keeps working. -->
  <ScrollViewer x:Name="PageScroll" Style="{StaticResource Scroll}" DataContext="{Binding Bestiary}">
    <Grid MaxWidth="1180" Margin="48,44,48,56">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header: who lives here, and how many the catalog knows -->
      <Grid c:Motion.Rise="True">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,24,0">
          <TextBlock>
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
                <Setter Property="Text" Value="{Binding Overview.Eyebrow}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsReading}" Value="True">
                    <Setter Property="Text" Value="{x:Static r:Strings.BestiaryReadingEyebrow}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Margin="0,12,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Title}">
                <Setter Property="Text" Value="{x:Static r:Strings.BestiaryTitle}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsReading}" Value="True">
                    <Setter Property="Text" Value="{x:Static r:Strings.BestiaryReadingTitle}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Margin="0,12,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Lead}">
                <Setter Property="Text" Value="{x:Static r:Strings.BestiaryLead}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsReading}" Value="True">
                    <Setter Property="Text" Value="{x:Static r:Strings.BestiaryReadingLead}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0" Visibility="{Binding IsReady, Converter={StaticResource Visible}}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Overview.CatalogedPercent}" Style="{StaticResource Small}" />
            <TextBlock Text="{Binding Overview.CatalogedLabel}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" />
          </DockPanel>
          <Grid Height="6" Margin="0,10,0,0">
            <Border CornerRadius="3" Background="{StaticResource SuperficieBordaBrush}" />
            <Border CornerRadius="3" Background="{StaticResource ModulosBestiarioBrush}" HorizontalAlignment="Left"
                    Width="{Binding Overview.CatalogedFraction, Converter={StaticResource FractionToWidth}, ConverterParameter=300}" />
          </Grid>
          <TextBlock Text="{x:Static r:Strings.BestiarySearch}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextoForteBrush}" Margin="0,22,0,8" />
          <Border Height="44" CornerRadius="{StaticResource RaioControle}" BorderThickness="1" Background="{StaticResource SuperficieCartaoBrush}"
                  BorderBrush="{StaticResource SuperficieBordaControleBrush}">
            <Grid Margin="14,0">
              <TextBlock Text="{x:Static r:Strings.BestiarySearchHint}" FontSize="14" Foreground="{StaticResource TextoSecundarioBrush}" VerticalAlignment="Center"
                         IsHitTestVisible="False" Visibility="{Binding Search, Converter={StaticResource Visible}, ConverterParameter=not}" />
              <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="14"
                       Foreground="{StaticResource TextoPrincipalBrush}" VerticalAlignment="Center" Padding="0" CaretBrush="{StaticResource TextoPrincipalBrush}" />
            </Grid>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Filters -->
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Filters}" Margin="0,28,0,0" Focusable="False" c:Motion.Rise="True" c:Motion.Index="1"
                    Visibility="{Binding IsReady, Converter={StaticResource Visible}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource FilterChip}" Command="{Binding SelectCommand}" Margin="0,0,8,8" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,32,0,0" Padding="22,24" Visibility="{Binding IsFailed, Converter={StaticResource Visible}}">
        <TextBlock Style="{StaticResource Body}" Text="{Binding Error}" />
      </Border>

      <!-- Inhabitants and the fiche of the selected one -->
      <Grid Grid.Row="2" Margin="0,20,0,0" Visibility="{Binding IsReady, Converter={StaticResource Visible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,0,20,0">
          <Border Style="{StaticResource Card}" Padding="22,24" Visibility="{Binding IsFilterEmpty, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Body}" Text="{x:Static r:Strings.BestiaryNoneInFilter}" />
          </Border>
          <ItemsControl ItemsSource="{Binding Visible}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" VerticalAlignment="Top" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource InhabitantCard}" Command="{Binding SelectCommand}" Margin="0,0,12,12"
                        c:Motion.Rise="True" c:Motion.Index="{Binding Index}">
                  <StackPanel>
                    <DockPanel>
                      <Border Width="40" Height="40" CornerRadius="{StaticResource RaioControle}"
                              Background="{Binding Level, Converter={StaticResource LevelBrush}, ConverterParameter=tile}">
                        <TextBlock Text="{Binding Initials}" FontSize="14" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding Level, Converter={StaticResource LevelBrush}, ConverterParameter=tileText}" />
                      </Border>
                      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Category}" Style="{StaticResource Small}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                      </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                      <Border Style="{StaticResource Chip}" BorderThickness="0"
                              Background="{Binding Level, Converter={StaticResource LevelBrush}, ConverterParameter=chip}">
                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding LevelLabel}"
                                   Foreground="{Binding Level, Converter={StaticResource LevelBrush}, ConverterParameter=text}" />
                      </Border>
                      <TextBlock Text="{Binding Cost}" Style="{StaticResource Small}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="12,0,0,0" />
                    </DockPanel>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Small}" Text="{Binding Overview.HiddenNote}" Margin="0,8,12,0"
                     Visibility="{Binding Overview.HiddenNote, Converter={StaticResource Visible}}" />
        </StackPanel>

        <!-- The fiche: follows the scroll so a card picked low in the list shows its fiche right away. Its actions stay
             pinned at the bottom; on short windows the rest scrolls inside it. -->
        <Border Grid.Column="1" Style="{StaticResource Panel}" VerticalAlignment="Top" Padding="24,24" c:Sticky.Gap="24"
                DataContext="{Binding Selected}" Visibility="{Binding Converter={StaticResource Visible}}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
              <Button Style="{StaticResource BestiaryButton}" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                      Command="{Binding DataContext.StopStartupCommand, ElementName=PageScroll}"
                      Visibility="{Binding CanStopStartup, Converter={StaticResource Visible}}">
                <TextBlock Text="{x:Static r:Strings.StopStartup}" />
              </Button>
              <Button Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                      Command="{Binding DataContext.OpenLocationCommand, ElementName=PageScroll}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource Icon.folder}" Stroke="{StaticResource TextoForteBrush}" StrokeThickness="1.8" Width="16" Height="16"
                        Stretch="Uniform" Margin="0,0,8,0" StrokeLineJoin="Round" />
                  <TextBlock Text="{x:Static r:Strings.OpenLocation}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <ScrollViewer Style="{StaticResource Scroll}" c:NestedScroll.Enabled="True">
              <StackPanel>
                <DockPanel>
                  <Border Width="52" Height="52" CornerRadius="{StaticResource RaioControle}"
                          Background="{Binding Level, Converter={StaticResource LevelBrush}, ConverterParameter=tile}">
                    <TextBlock Text="{Binding Initials}" FontSize="17" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding Level, Converter={StaticResource LevelBrush}, ConverterParameter=tileText}" />
                  </Border>
                  <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="ExtraBold" Foreground="{StaticResource TextoPrincipalBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding FileName}" Style="{StaticResource Small}" Margin="0,2,0,0" />
                  </StackPanel>
                </DockPanel>
    
                <WrapPanel Margin="0,16,0,0">
                  <Border Style="{StaticResource Chip}" BorderThickness="0" Margin="0,0,8,0"
                          Background="{Binding Level, Converter={StaticResource LevelBrush}, ConverterParameter=chip}">
                    <TextBlock Style="{StaticResource ChipText}" Text="{Binding LevelLabel}"
                               Foreground="{Binding Level, Converter={StaticResource LevelBrush}, ConverterParameter=text}" />
                  </Border>
                  <Border Style="{StaticResource Chip}" BorderThickness="0" Background="{StaticResource StatusPerigoFundoBrush}"
                          Visibility="{Binding ImpostorChip, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource ChipText}" Text="{Binding ImpostorChip}" Foreground="{StaticResource StatusPerigoBrush}" />
                  </Border>
                </WrapPanel>
    
                <TextBlock Style="{StaticResource FicheLabel}" Text="{x:Static r:Strings.FicheWho}" />
                <TextBlock Style="{StaticResource Body}" Text="{Binding Who}" Foreground="{StaticResource TextoForteBrush}" />
    
                <TextBlock Style="{StaticResource FicheLabel}" Text="{Binding ReasonsTitle}" Visibility="{Binding Reasons, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding Reasons}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,8">
                        <Path DockPanel.Dock="Left" Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.8" Margin="0,2,10,0" VerticalAlignment="Top"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="{Binding DataContext.ReasonIcon, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Icon}}"
                              Stroke="{Binding DataContext.Level, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource LevelBrush}, ConverterParameter=text}" />
                        <TextBlock Style="{StaticResource Body}" FontSize="13" Text="{Binding}" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
    
                <ItemsControl ItemsSource="{Binding Stats}" Margin="0,12,0,0" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="{StaticResource RaioControle}" Background="{StaticResource SuperficieFundoBrush}" Padding="12,10" Margin="0,0,8,8">
                        <StackPanel>
                          <TextBlock Text="{Binding Value}" FontSize="17" FontWeight="ExtraBold" Foreground="{StaticResource TextoPrincipalBrush}" />
                          <TextBlock Text="{Binding Label}" Style="{StaticResource Small}" FontSize="11.5" Margin="0,2,0,0" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
    
                <StackPanel Visibility="{Binding StartupAdvice, Converter={StaticResource Visible}}">
                  <TextBlock Style="{StaticResource FicheLabel}" Text="{x:Static r:Strings.FicheStartup}" Margin="0,12,0,8" />
                  <TextBlock Style="{StaticResource Body}" FontSize="13" Text="{Binding StartupAdvice}" />
                </StackPanel>
    
                <TextBlock Style="{StaticResource FicheLabel}" Text="{x:Static r:Strings.FicheWhere}" />
                <TextBlock Style="{StaticResource Small}" Text="{Binding Path}" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
