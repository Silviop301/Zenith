<UserControl x:Class="Zenith.App.Views.HdrTrialDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Zenith.Core.Resources;assembly=Zenith.Core">
  <Border Style="{StaticResource Dialog}">
    <StackPanel>
      <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left" Background="{StaticResource ResgateSuaveBrush}">
        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.hdr}" Stroke="{StaticResource ModulosResgateBrush}" />
      </Border>
      <TextBlock Style="{StaticResource DialogTitle}" Text="{x:Static r:Strings.HdrTrialTitle}" Margin="0,20,0,0" />
      <TextBlock Style="{StaticResource Lead}" FontSize="15" Text="{x:Static r:Strings.HdrTrialBody}" Margin="0,8,0,0" />

      <!-- Countdown: the bar empties in 15 s, then HDR goes back off. -->
      <Grid Margin="0,24,0,0" Height="6">
        <Border CornerRadius="3" Background="{StaticResource SuperficieDivisoriaBrush}" />
        <Border CornerRadius="3" Background="{StaticResource ModulosResgateBrush}" HorizontalAlignment="Left"
                Width="{Binding Remaining, Converter={StaticResource FractionToWidth}, ConverterParameter=496}" />
      </Grid>
      <TextBlock Style="{StaticResource Small}" Text="{Binding CountdownText}" Margin="0,8,0,0" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
        <Button Style="{StaticResource SecondaryButton}" Command="{Binding RevertCommand}">
          <TextBlock Text="{x:Static r:Strings.HdrTrialRevert}" />
        </Button>
        <Button Style="{StaticResource PrimaryButton}" Command="{Binding KeepCommand}" Margin="12,0,0,0">
          <TextBlock Text="{x:Static r:Strings.HdrTrialKeep}" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
