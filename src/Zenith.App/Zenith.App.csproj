<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>zenith</AssemblyName>
    <RootNamespace>Zenith.App</RootNamespace>
    <ApplicationIcon>zenith.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zenith.Core\Zenith.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Manrope, static weights (SIL Open Font License, see Fonts/OFL.txt). -->
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="zenith.ico" />
    <!-- The design tokens are the source of truth for colors; the app uses them as they are. -->
    <Page Include="..\..\design\tokens\Cores.xaml" Link="Theme\Cores.xaml" />
  </ItemGroup>
</Project>
